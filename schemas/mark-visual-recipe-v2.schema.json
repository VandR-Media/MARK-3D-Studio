{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MARK Visual Engine v2 — non executable scene recipe",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "commands"
  ],
  "properties": {
    "schema": {
      "const": "mark.visual-recipe/2"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{1,79}$"
    },
    "name": {
      "type": "string",
      "maxLength": 120
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/command"
      }
    }
  },
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "args"
      ],
      "properties": {
        "operation": {
          "enum": [
            "instrument.create",
            "object.add",
            "object.transform",
            "object.material",
            "object.group",
            "object.rename",
            "object.remove",
            "object.clone",
            "material.set",
            "camera.set",
            "environment.set",
            "lighting.set",
            "overlay.add",
            "signal.bind",
            "quality.set"
          ]
        },
        "args": {
          "type": "object"
        }
      }
    }
  }
}
