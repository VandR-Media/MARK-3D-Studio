{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MARK Modeling API v0.4 Recipe",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "project",
    "commands"
  ],
  "properties": {
    "schema": {
      "const": "mark-modeling/0.4"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "base"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]{3,60}$"
        },
        "name": {
          "type": "string"
        },
        "base": {
          "enum": [
            "practice-head",
            "provided-glb",
            "contour-head-v1"
          ]
        },
        "seed": {
          "type": "integer"
        },
        "references": {
          "type": "object"
        },
        "controls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "head": {
              "type": "object",
              "additionalProperties": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "eyes": {
              "type": "object",
              "additionalProperties": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "eyelids": {
              "type": "object",
              "additionalProperties": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "eyebrows": {
              "type": "object",
              "additionalProperties": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "nose": {
              "type": "object",
              "additionalProperties": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "cheeks": {
              "type": "object",
              "additionalProperties": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "chin": {
              "type": "object",
              "additionalProperties": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "mouth": {
              "type": "object",
              "additionalProperties": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "lips": {
              "type": "object",
              "additionalProperties": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "ears": {
              "type": "object",
              "additionalProperties": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "hair": {
              "type": "object",
              "additionalProperties": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "skin": {
              "type": "object",
              "additionalProperties": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        }
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/command"
      }
    }
  },
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation"
      ],
      "properties": {
        "operation": {
          "enum": [
            "face.modify",
            "feature.build",
            "geometry.loft",
            "geometry.sweep",
            "mesh.topology",
            "mesh.sculpt",
            "object.transform",
            "mesh.inspect",
            "checkpoint.save",
            "material.set"
          ]
        },
        "target": {
          "type": "string"
        },
        "parameters": {
          "type": "object"
        },
        "onError": {
          "enum": [
            "skip",
            "abort"
          ]
        }
      }
    }
  }
}
