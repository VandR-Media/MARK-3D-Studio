{
  "name": "mark-3d-studio",
  "version": "0.7.0-alpha.0",
  "private": true,
  "type": "module",
  "description": "Mobile-first browser editor of real GLB PBR materials",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test tests/glb.test.mjs",
    "smoke:glb": "node scripts/export-sample.mjs",
    "serve": "python3 -m http.server 8080",
    "build:standalone": "node scripts/build-standalone.mjs",
    "test:standalone": "node --test tests/standalone.test.mjs",
    "test:mesh": "node --test tests/mesh.test.mjs",
    "mesh:fixtures": "node scripts/export-head.mjs",
    "test:topology": "node --test tests/topology.test.mjs",
    "test:scene": "node --test tests/scene.test.mjs",
    "test:face": "node --test tests/face.test.mjs",
    "character:fixtures": "node scripts/export-character.mjs",
    "character:build": "node scripts/character-build.mjs",
    "test:modeling": "node --test tests/modeling-api.test.mjs",
    "test:professional": "node --test tests/professional-core.test.mjs",
    "professional:build": "node scripts/professional-build.mjs",
    "test:compact": "node --test tests/compact-project.test.mjs",
    "benchmark:compact": "node scripts/benchmark-compact.mjs",
    "test:visual-v2": "node --test tests/visual-engine-v2.test.mjs",
    "visual:v2:recipe": "node scripts/visual-v2-build.mjs",
    "visual:v2:build": "node scripts/build-visual-v2.mjs",
    "visual:v2:accept": "node scripts/visual-v2-accept.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "three": "0.187.0",
    "ajv": "8.17.1",
    "fflate": "0.8.2"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "pngjs": "7.0.0",
    "playwright": "1.56.0"
  }
}
