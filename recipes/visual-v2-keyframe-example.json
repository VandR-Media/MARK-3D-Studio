{
  "schema": "mark.visual-recipe/2",
  "id": "analog-studio-keyframe-v2",
  "name": "Analog Studio with one editable keyframe clip",
  "commands": [
    {
      "operation": "instrument.create",
      "args": {
        "kind": "analog-studio",
        "params": {}
      }
    },
    {
      "operation": "animation.set",
      "args": {
        "clip": {
          "id": "camera-tilt-study",
          "duration": 2,
          "loop": true,
          "tracks": [
            {
              "target": "case.main",
              "property": "rotation",
              "keys": [
                {
                  "time": 0,
                  "value": [
                    0,
                    0,
                    0
                  ]
                },
                {
                  "time": 1,
                  "value": [
                    0,
                    0.09,
                    0
                  ]
                },
                {
                  "time": 2,
                  "value": [
                    0,
                    0,
                    0
                  ]
                }
              ]
            }
          ]
        }
      }
    }
  ]
}
