{
  "schema": "mark-geometry/0.1",
  "project": {
    "id": "anatomical-head-stage2-demo",
    "base": "empty",
    "description": "Editable child-head QUAD topology with real recessed eye, mouth and nostril loops. NOT final MARK Cosmic"
  },
